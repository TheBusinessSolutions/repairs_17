<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main repair product -->
    <record id="view_repair_order_form_inherit_service" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.service</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id'][1]" position="attributes">
                <attribute name="domain">
                    [('detailed_type', 'in', ['product', 'consu', 'service'])]
                </attribute>
                <attribute name="context">
                    {'default_detailed_type': 'service'}
                </attribute>
            </xpath>

            <!-- Parts lines products -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="attributes">
                <attribute name="domain">
                    [('detailed_type', 'in', ['product', 'consu', 'service'])]
                </attribute>
                <attribute name="context">
                    {'default_detailed_type': 'service'}
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>