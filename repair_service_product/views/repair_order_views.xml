<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_repair_order_form_inherit_service" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.service</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">
                    [('detailed_type', 'in', ['product', 'consu', 'service']), '|', ('company_id', '=', False), ('company_id', '=', company_id)]
                </attribute>
            </xpath>
        </field>
    </record>

</odoo>