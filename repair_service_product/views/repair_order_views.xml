<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_service" model="ir.ui.view">
        <name>repair.order.form.inherit.service</name>
        <model>repair.order</model>
        <inherit_id ref="repair.view_repair_order_form"/>
        <arch type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('type', 'in', ['product', 'consu', 'service']), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
            </xpath>
        </arch>
    </record>
</odoo>